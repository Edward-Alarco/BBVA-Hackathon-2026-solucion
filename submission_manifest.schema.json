{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/log-8092/submission-manifest-0.4.0.schema.json",
  "title": "LOG-8092 Submission Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate",
    "candidate_name",
    "models_and_tools",
    "evaluated_file",
    "generated_artifacts",
    "conversation_files",
    "redactions",
    "declaration"
  ],
  "properties": {
    "candidate": {"type": "string", "minLength": 1},
    "candidate_name": {"type": "string", "minLength": 1},
    "models_and_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "model"],
        "properties": {
          "tool": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1}
        }
      }
    },
    "evaluated_file": {"const": "candidate_strategy.py"},
    "generated_artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "conversation_files": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "reason"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "declaration": {"type": "string", "minLength": 20}
  }
}
